# Copia este archivo a ".env" y rellena los valores. NUNCA subas el .env a GitHub.

# Token que te da @BotFather (genera uno nuevo con /revoke si lo expusiste).
TELEGRAM_TOKEN=pon-aqui-tu-token

# Tu chat ID. Ejecuta "python get_chat_id.py" para descubrirlo
# (despues de haberle escrito algo a tu bot en Telegram).
CHAT_ID=pon-aqui-tu-chat-id

# Clave de la API de Gemini (gratis) para redactar el resumen. Obtenla en
# aistudio.google.com -> "Get API key". Empieza con "AIza".
GEMINI_API_KEY=pon-aqui-tu-api-key

# (Opcional) Clave de Groq como respaldo si se agota Gemini. Gratis en
# console.groq.com -> "API Keys". Empieza con "gsk_". Si la dejas vacia,
# el bot usa solo Gemini.
GROQ_API_KEY=

# (Opcional) Clave de Tavily para que el bot conversacional busque en TODO
# internet (no solo Google News). Gratis en app.tavily.com -> API Keys.
# Empieza con "tvly-". Si la dejas vacia, el bot usa solo Google News + RSS.
TAVILY_API_KEY=


# --- Solo para desplegar el bot conversacional (Cloudflare Worker) ---
# No hacen falta si solo vas a trabajar en bot.py / breaking.py.

# Token de Cloudflare con la plantilla "Edit Cloudflare Workers".
CLOUDFLARE_API_TOKEN=

# ID de la cuenta de Cloudflare (barra lateral del panel de Workers).
CLOUDFLARE_ACCOUNT_ID=

# Secreto compartido entre Telegram y el Worker, y llave de los endpoints de
# depuracion (/ingest, /entorno). NO lo rellenes a mano: scripts/deploy_worker.py
# lo genera y lo escribe aqui la primera vez que lo corres.
WEBHOOK_SECRET=

# (Opcional) PAT de GitHub fine-grained con permiso "Actions: read/write" sobre
# este repo, para que el bot pueda disparar el render de las laminas del
# newsletter. Si lo dejas vacio, el newsletter llega en texto y el bot avisa que
# no pudo generar las laminas.
GITHUB_PAT=
